# ATLAS-Q Environment Configuration
# Render automatically injects PORT (default: 8000)

PORT=8000
PYTHON_VERSION=3.11.9
NODE_VERSION=20.12.0
PYTHONUNBUFFERED=1

# Optional External API Keys (Open-Meteo is free and keyless by default)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
IMD_DATA_GATEWAY_URL=https://mausam.imd.gov.in
ISRO_MOSDAC_GATEWAY_URL=https://www.mosdac.gov.in
